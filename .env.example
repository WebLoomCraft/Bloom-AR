# Required — PostgreSQL / Neon connection
# Set DATABASE_URL (direct) and optionally DATABASE_URL_POOLED (pooled -pooler host for serverless runtime).
# Neon "?sslmode=require&channel_binding=require" URLs are supported automatically.
# Note: NEON_AUTH_BASE_URL / NEON_REALTIME_* are NOT used (BloomAR Manager uses built-in JWT_SECRET auth).
DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_POOLED=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
JWT_SECRET=replace-with-a-long-random-secret
# App / domains
NEXT_PUBLIC_APP_URL=https://your-app-domain.example
NEXT_PUBLIC_ROOT_DOMAIN=your-app-domain.example
# Email (required for verification / reset / invites to actually send)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BloomRCM <bloomrcm@gmail.com>"
# Platform admin (one of these grants /admin/platform access; set privately in hosting env, never commit real values)
# Comma-separated allowlist — matching sign-ins are auto-promoted to users.is_platform_admin
PLATFORM_ADMIN_EMAILS=
# Bootstrap script only (scripts/bootstrap-platform-admin.mjs): creates/promotes one admin
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_TEMP_PASSWORD=
PLATFORM_ADMIN_FIRST_NAME=
PLATFORM_ADMIN_LAST_NAME=
# Payments (optional until checkout is enabled; never put card data in the DB)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Hosting domain provisioning (optional, for custom-domain automation status)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# ---------------------------------------------------------------------------
# Legal agreements — business identity (REQUIRED before your legal pages and
# Stripe review are complete). Every value left blank renders as a visible
# [[PLACEHOLDER]] on /legal/* rather than an invented detail. None of these are
# secrets; they are the public identity of the contracting business.
# ---------------------------------------------------------------------------
# Operating business name (owner-supplied: BloomRCM, https://bloomrcm.vercel.app)
LEGAL_ENTITY_NAME=BloomRCM
# Product/trade name used in agreements (defaults to "BloomAR Manager")
LEGAL_DBA=BloomAR Manager
# BloomRCM's own website
LEGAL_BUSINESS_WEBSITE=https://bloomrcm.vercel.app
LEGAL_ADDRESS_LINE1=
LEGAL_ADDRESS_LINE2=
LEGAL_CITY=
LEGAL_REGION=
LEGAL_POSTAL_CODE=
LEGAL_COUNTRY=United States
# State of incorporation / organization
LEGAL_INCORPORATION_STATE=
# Monitored contact addresses (agreements reference each for a specific purpose).
# For now BloomRCM uses one business inbox for every purpose:
LEGAL_SUPPORT_EMAIL=bloomrcm@gmail.com
LEGAL_SUPPORT_PHONE=
LEGAL_PRIVACY_EMAIL=bloomrcm@gmail.com
LEGAL_SECURITY_EMAIL=bloomrcm@gmail.com
LEGAL_NOTICES_EMAIL=bloomrcm@gmail.com
# Governing law for the Terms / DPA / BAA, and the venue county
LEGAL_GOVERNING_STATE=
LEGAL_VENUE=
